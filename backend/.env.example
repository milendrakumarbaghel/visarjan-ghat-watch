# Copy this file to .env (same folder) and fill in your PostgreSQL connection.
# .env is listed in .gitignore and is never committed.
#
# Local PostgreSQL:
#   DB_URL=jdbc:postgresql://localhost:5432/ghat_watch
# Hosted (e.g. Neon) - add sslmode=require:
#   DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ghat_watch
DB_USER=postgres
DB_PASSWORD=
# Optional:
# PORT=8080
# ALLOWED_ORIGINS=http://localhost:5173,https://visarjan-ghat-watch-frontend.vercel.app
